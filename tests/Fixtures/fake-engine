#!/bin/sh
# Fake engine for CoreTests. Writes its arguments to $FAKE_ENGINE_LOG.
[ -n "$FAKE_ENGINE_LOG" ] && echo "$*" >> "$FAKE_ENGINE_LOG"
case "$1" in
  status) cat "$(dirname "$0")/status.json" ;;
  fail)   echo "ERROR: Claude did not quit." >&2; exit 1 ;;
  badjson) echo "not json" ;;
  *)      echo '{"ok": true, "count": 4}' ;;
esac
