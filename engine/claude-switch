class Fail(Exception):
    pass


class Busy(Fail):
    """The lock is held: a switch, the 5-minute tick or another engine task runs now."""


# ---------- small helpers ----------

def log(msg):
    try:
        if os.path.exists(LOG) and os.path.getsize(LOG) > 1_000_000:
            os.replace(LOG, LOG + ".1")
        with open(LOG, "a") as f:
            f.write(f"{datetime.datetime.now():%F %T} {msg}\n")
    except OSError:
        pass


def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_json(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


def settings():
    s = dict(DEFAULTS)
    s.update(read_json(SETTINGS, {}) or {})
    if "shareSessions" in s:  # renamed in v1.0
        s.setdefault("syncOnSwitch", s["shareSessions"])
        if s.pop("shareSessions"):
            s["syncOnSwitch"] = True
    s["owned"] = list(s.get("owned") or [])
    s["labels"] = dict(s.get("labels") or {})
    s["hidden"] = list(s.get("hidden") or [])
    s["order"] = list(s.get("order") or [])
    s["pinned"] = list(s.get("pinned") or [])
    if os.path.exists(OLD_LABELS) and not s.get("importedV1Labels"):  # names from version 1
        for line in open(OLD_LABELS):
            p = line.rstrip("\n").split(" ", 1)
            if len(p) == 2 and p[1].strip():
                s["labels"].setdefault(p[0], p[1].strip())
        s["importedV1Labels"] = True
        write_json(SETTINGS, s)
    return s


def save_settings(s):
    write_json(SETTINGS, s)


@contextlib.contextmanager
def lock():
    f = open(os.path.join(BASE, "lock"), "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise Busy("Another switch is running. Wait for it to finish.")
    try:
        yield
    finally:
        fcntl.flock(f, fcntl.LOCK_UN)
        f.close()


def lock_held():
    """True while another engine process holds the lock (a switch is running now)."""
    try:
        with open(os.path.join(BASE, "lock"), "w") as f:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fcntl.flock(f, fcntl.LOCK_UN)
        return False
    except BlockingIOError:
        return True


def account_dirs():
    """{account: [org folders]} from the session store."""
    out = {}
    for d in glob.glob(os.path.join(SESS, "*", "*")):
        if os.path.isdir(d):
            out.setdefault(os.path.basename(os.path.dirname(d)), []).append(d)
    return out


def known_accounts():
    ids = set(account_dirs()) | {p for p in os.listdir(PROFILES) if not p.startswith(".")}
    cur = current_account()
    if cur:
        ids.add(cur)
    return ids


def resolve(acc):
    if not acc:
        raise Fail("Give an account ID.")
    m = [a for a in known_accounts() if a == acc or a.startswith(acc)]
    if len(m) != 1:
        raise Fail(f"Unknown or unclear account: {acc}")
    return m[0]


# ---------- journal (crash safety) ----------
#
# A switch writes its progress to journal.json before each step that changes files:
#   started -> saved -> loaded -> synced -> (journal deleted)
# `recover` reads it: before "saved" nothing changed; at "saved" the target login may be
# half loaded, so it rolls back to last-state; at "loaded"/"synced" the target is complete.

def crash_point(name):
    """Test hook: CLAUDE_SWITCH_CRASH_AFTER=<name> kills the engine here, like kill -9."""
    if os.environ.get("CLAUDE_SWITCH_CRASH_AFTER") == name:
        os._exit(137)


def checkpoint(step, **extra):
    j = read_json(JOURNAL, {}) or {}
    j.update(extra)
    j["step"], j["at"] = step, time.time()
    write_json(JOURNAL, j)
    log(f"journal: {j.get('op')} {step}")
    crash_point(step)


def pending():
    return read_json(JOURNAL)


def require_no_pending():
    if pending():
        raise Fail("A switch stopped in the middle. Run recover first. The app does this by itself when it starts.")


def end_journal():
    with contextlib.suppress(FileNotFoundError):
        os.remove(JOURNAL)


# ---------- version and layout guard ----------

def claude_version():
    try:
        with open(INFO_PLIST, "rb") as f:
            return plistlib.load(f).get("CFBundleShortVersionString", "")
    except (OSError, plistlib.InvalidFileException, ValueError):
        return ""


def tested_versions(s=None):
    return sorted(set(TESTED_VERSIONS) | set((s or settings()).get("verifiedVersions") or []))


def layout_problems():
    """Ways in which the Claude data folder differs from the layout this engine knows."""
    probs = []
    cfg = read_json(os.path.join(APP, "config.json"))
    if not isinstance(cfg, dict):
        return ["config.json is missing or is not JSON"]
    if not os.path.isdir(SESS):
        probs.append("the claude-code-sessions folder is missing")
    signed_in = bool(cfg.get("oauth:tokenCacheV2"))
    if signed_in and not cfg.get("lastKnownAccountUuid"):
        probs.append("config.json has a token but no lastKnownAccountUuid")
    cookies = os.path.join(APP, "Cookies")
    if os.path.exists(cookies):
        try:
            con = sqlite3.connect(f"file:{cookies}?immutable=1", uri=True)
            cols = {r[1] for r in con.execute("pragma table_info(cookies)")}
            con.close()
            if not {"host_key", "name"} <= cols:
                probs.append("the Cookies database has no cookies(host_key, name) table")
        except sqlite3.Error:
            probs.append("the Cookies file is not a database")
    elif signed_in:
        probs.append("Claude is signed in but has no Cookies file")
    return probs


def guard(force):
    """Stop before any change if the login layout is unknown. Returns (version, warning)."""
    v = claude_version()
    probs = layout_problems()
    if probs and not force:
        raise Fail(f"Claude {v or '(unknown version)'} stores its login in a way this app does not know: "
                   + "; ".join(probs) + ". Nothing was changed. Update Claude Accounts, or use --force at your own risk.")
    warn = None
    if v not in tested_versions():
        warn = f"Claude {v or '(unknown version)'} is not tested yet. Its login layout looks the same, so the switch ran."
    if probs:
        warn = "Forced switch on an unknown layout: " + "; ".join(probs)
    return v, warn


# ---------- Claude app state ----------

def current_account():
    return (read_json(os.path.join(APP, "config.json"), {}) or {}).get("lastKnownAccountUuid") or ""


def claude_running():
    if TEST:
        return os.path.exists(os.path.join(APP, ".running"))
    out = subprocess.run(["ps", "-axo", "comm"], capture_output=True, text=True).stdout
    return CLAUDE_BIN in out.splitlines()


QUIT_WAIT = 90  # seconds; Claude may ask the user to confirm the quit


def quit_claude():
    if TEST and os.environ.get("CLAUDE_SWITCH_QUIT_FAIL"):
        raise Fail("Claude did not quit (test).")
    if TEST or not claude_running():
        return
    subprocess.run(["osascript", "-e", f'tell application id "{BUNDLE_ID}" to quit'], capture_output=True)
    for _ in range(QUIT_WAIT * 2):
        if not claude_running():
            time.sleep(1)
            return
        time.sleep(0.5)
    raise Fail(f"Claude did not quit within {QUIT_WAIT} seconds. Claude may be asking you to confirm the quit, "
               "or a task is still running in it (for example, a command started from Claude itself). "
               "Answer Claude's dialog or finish the task, then switch again. Nothing was changed.")


def quit_or_cancel():
    """Quit Claude. If that fails, no file has changed yet, so remove the journal and stop."""
    try:
        quit_claude()
    except Fail:
        end_journal()
        log("cancelled before any change: Claude did not quit")
        raise


def open_claude(url=None):
    if TEST:
        return
    subprocess.run(["open", url] if url else ["open", "-b", BUNDLE_ID])


def cookie_has_session(path):
    if not os.path.exists(path):
        return False
    try:
        con = sqlite3.connect(f"file:{path}?immutable=1", uri=True)
        n = con.execute("select count(*) from cookies where host_key like '%claude.ai' and name='sessionKey'").fetchone()[0]
        con.close()
        return n > 0
    except sqlite3.Error:
        return False


def has_login(app=APP):
    cfg = read_json(os.path.join(app, "config.json"), {}) or {}
    return bool(cfg.get("oauth:tokenCacheV2")) and cookie_has_session(os.path.join(app, "Cookies"))


# ---------- saving and loading a login ----------

def save_login(dest, mode):
    """Copy the login of the desktop app into folder `dest`. mode: switch | auto | signin."""
    live = mode in ("auto", "signin")  # Claude may be running
    tmp = dest + ".tmp"
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(tmp)
    for f in LOGIN_FILES:
        src = os.path.join(APP, f)
        if not os.path.exists(src):
            continue
        if live and f == "Cookies":  # consistent copy while Claude writes to it
            s = sqlite3.connect(f"file:{src}?mode=ro", uri=True)
            d = sqlite3.connect(os.path.join(tmp, f))
            s.backup(d)
            d.close(); s.close()
        elif not (live and f.endswith("-journal")):
            shutil.copy2(src, tmp)
    for d in LOGIN_DIRS:
        src = os.path.join(APP, d)
        if os.path.isdir(src):
            shutil.copytree(src, os.path.join(tmp, d), symlinks=True,
                            ignore=shutil.ignore_patterns("LOCK"), ignore_dangling_symlinks=True,
                            dirs_exist_ok=True)
    cfg = read_json(os.path.join(APP, "config.json"), {}) or {}
    write_json(os.path.join(tmp, "config-keys.json"), {k: cfg[k] for k in CONFIG_KEYS if k in cfg})
    write_json(os.path.join(tmp, "meta.json"), {"savedAt": time.time(), "mode": mode})
    shutil.rmtree(dest, ignore_errors=True)
    os.replace(tmp, dest)


def load_login(src):
    """Replace the login of the desktop app with the one in `src` (None = signed out)."""
    for f in LOGIN_FILES:
        with contextlib.suppress(FileNotFoundError):
            os.remove(os.path.join(APP, f))
    for d in LOGIN_DIRS:
        shutil.rmtree(os.path.join(APP, d), ignore_errors=True)
    crash_point("mid-load")
    keys = {}
    if src:
        for f in LOGIN_FILES:
            if os.path.exists(os.path.join(src, f)):
                shutil.copy2(os.path.join(src, f), APP)
        for d in LOGIN_DIRS:
            if os.path.isdir(os.path.join(src, d)):
                shutil.copytree(os.path.join(src, d), os.path.join(APP, d), symlinks=True)
        keys = read_json(os.path.join(src, "config-keys.json"), {}) or {}
    path = os.path.join(APP, "config.json")
    cfg = read_json(path, {}) or {}
    for k in CONFIG_KEYS:
        cfg.pop(k, None)
    cfg.update(keys)
    write_json(path, cfg)


def profile_meta(acc):
    return read_json(os.path.join(PROFILES, acc, "meta.json"))


def save_current(mode="switch"):
    cur = current_account()
    if cur and has_login():
        save_login(os.path.join(PROFILES, cur), mode)
        log(f"saved login of {cur} ({mode})")
    else:
        log(f"no login to save (current={cur or '-'})")
    if mode == "switch":  # exact copy of the state before a change, for recovery
        save_login(LAST_STATE, "switch")


# ---------- sessions ----------

def session_index(acc, dirs):
    """Session files of one account: ({file name: [paths]}, {deleted session ids})."""
    files, deleted = {}, set()
    for d in dirs.get(acc, []):
        for name in os.listdir(d):
            if name.startswith("local_") and name.endswith(".json"):
                files.setdefault(name, []).append(os.path.join(d, name))
            elif name.startswith("deleted_"):
                deleted.add(name[len("deleted_"):])
    return files, deleted


def owned(s=None):
    return set((s or settings())["owned"])


def sync_sessions(dry=False):
    """Two-way sync of session list files between "mine" accounts.

    Rules: the newest copy of a session (by modification time) goes to every "mine" account
    that has an older copy or none; a session deleted in any "mine" account is not copied
    to accounts that do not have it; nothing is ever deleted; accounts that are not "mine"
    are not read and not written.
    """
    dirs = account_dirs()
    members = sorted(a for a in owned() if dirs.get(a))
    skipped = sorted(a for a in owned() if not dirs.get(a))
    idx = {a: session_index(a, dirs) for a in members}
    deleted = set().union(*(idx[a][1] for a in members)) if members else set()
    newest = {}
    for a in members:
        for name, paths in idx[a][0].items():
            for p in paths:
                m = os.path.getmtime(p)
                if name not in newest or m > newest[name][0]:
                    newest[name] = (m, p)
    changes = {}
    for a in members:
        target = max(dirs[a])  # stable choice of org folder for new files
        if len(dirs[a]) > 1:
            target = max(dirs[a], key=lambda d: (len(os.listdir(d)), d))
        have, n = idx[a][0], 0
        for name, (m, src) in newest.items():
            if name in have:
                for p in have[name]:
                    if p != src and os.path.getmtime(p) < m - 1:
                        n += 1
                        if not dry:
                            shutil.copy2(src, p)
            elif name[len("local_"):-len(".json")] not in deleted:
                n += 1
                if not dry:
                    shutil.copy2(src, os.path.join(target, name))
        changes[a] = n
    total = sum(changes.values())
    log(f"sync: {total} changes in {sum(1 for v in changes.values() if v)} accounts{' (dry run)' if dry else ''}")
    return {"changes": total, "accounts": changes, "skipped": skipped, "dryRun": dry}


def transcript_tail(cli_id, size=65536):
    for p in glob.glob(f"{HOME}/.claude/projects/*/{cli_id}.jsonl"):
        with open(p, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - size))
            return f.read().decode("utf-8", "ignore").splitlines()
    return []


MONTHS = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
WEEKDAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
RESET_RE = re.compile(r"^(?:at\s+)?(?:(?P<mon>[A-Za-z]{3})[a-z]*\s+(?P<day>\d{1,2}),?\s+|(?P<wday>[A-Za-z]{3})[a-z]*,?\s+)?"
                      r"(?P<h>\d{1,2})(?::(?P<m>\d{2}))?\s*(?P<ap>[ap]m)\s*(?:\((?P<tz>[A-Za-z0-9_+\-/]+)\))?\s*$", re.I)


def reset_timestamp(text, stopped_at):
    """Epoch seconds of a reset text such as "8pm (Asia/Calcutta)" or "Nov 10, 5pm (America/New_York)".
    The reset is the first such time after stopped_at (ISO time). None when the text cannot be read."""
    m = RESET_RE.match((text or "").strip())
    if not m:
        return None
    try:
        from zoneinfo import ZoneInfo
        tz = ZoneInfo(m["tz"]) if m["tz"] else None
        ref = datetime.datetime.fromisoformat(stopped_at.replace("Z", "+00:00")) if stopped_at else None
    except Exception:
        return None
    if ref is None or ref.tzinfo is None:
        ref = datetime.datetime.now(datetime.timezone.utc)
    ref = ref.astimezone(tz) if tz else ref.astimezone()
    h, mi = int(m["h"]), int(m["m"] or 0)
    if not (1 <= h <= 12 and mi < 60):
        return None
    h = h % 12 + (12 if m["ap"].lower() == "pm" else 0)

    def at(day):
        # Build the wall time in the zone, then fold it into the zone (handles DST offsets).
        naive = datetime.datetime(day.year, day.month, day.day, h, mi)
        return naive.replace(tzinfo=tz) if tz else naive.astimezone()

    if m["mon"]:
        if m["mon"].lower() not in MONTHS:
            return None
        mon, day = MONTHS.index(m["mon"].lower()) + 1, int(m["day"])
        for year in (ref.year, ref.year + 1):
            with contextlib.suppress(ValueError):
                t = at(datetime.date(year, mon, day))
                if t > ref - datetime.timedelta(days=1):
                    return int(t.timestamp())
        return None
    want = None
    if m["wday"]:
        if m["wday"].lower() not in WEEKDAYS:
            return None
        want = WEEKDAYS.index(m["wday"].lower())
    for add in range(8):
        d = ref.date() + datetime.timedelta(days=add)
        t = at(d)
        if t > ref and (want is None or d.weekday() == want):
            return int(t.timestamp())
    return None


def recent_sessions(days):
    """{session file name: (mtime, data, path)} of the newest copy of each session file changed
    in the last `days`. Sync copies a session into several account folders under the same file
    name, so only the newest copy is read. The data is read once per run (see session_data)."""
    cutoff = time.time() - days * 86400
    newest = {}
    for f in glob.glob(os.path.join(SESS, "*", "*", "local_*.json")):
        m = os.path.getmtime(f)
        name = os.path.basename(f)
        if m >= cutoff and (name not in newest or newest[name][0] < m):
            newest[name] = (m, f)
    out = {}
    for name, (m, f) in newest.items():
        d = session_data(f)
        if isinstance(d, dict):
            out[name] = (m, d, f)
    return out


@functools.lru_cache(maxsize=None)
def session_data(path):
    return read_json(path, {}) or {}


def paused_sessions(days=3):
    """Sessions whose last turn ended on a usage-limit error. The account is the one active at
    the stop time (see owner_at), because sync copies a session into several account folders."""
    newest, timeline, known = {}, None, set()
    for m, d, f in recent_sessions(days).values():
        sid = d.get("sessionId")
        if sid and (sid not in newest or newest[sid][0] < m):
            newest[sid] = (m, d, f)
    out = []
    for sid, (m, d, f) in newest.items():
        if d.get("isArchived") or not d.get("cliSessionId"):
            continue
        last = None
        for line in transcript_tail(d["cliSessionId"]):
            with contextlib.suppress(ValueError):
                e = json.loads(line)
                if e.get("type") in ("assistant", "user"):
                    last = e
        if not last or last.get("type") != "assistant" or not last.get("isApiErrorMessage"):
            continue
        content = (last.get("message") or {}).get("content")
        text = " ".join(c.get("text", "") for c in content if isinstance(c, dict)) if isinstance(content, list) else str(content)
        if "limit" not in text.lower():
            continue
        reset = re.search(r"resets? ([^·\n]+)", text)
        resets = reset.group(1).strip() if reset else ""
        stopped = last.get("timestamp", "")
        if timeline is None:
            timeline, known = active_timeline(), set(known_accounts())
        try:
            at = datetime.datetime.fromisoformat(stopped.replace("Z", "+00:00")).timestamp()
        except (ValueError, AttributeError):
            at = None
        account = owner_at(at, timeline, known, f.split(os.sep)[-3])
        out.append({"id": sid, "title": d.get("title") or "Untitled", "account": account,
                    "cwd": d.get("cwd", ""), "message": text.strip()[:160], "resets": resets,
                    "resetsAt": reset_timestamp(resets, stopped), "stoppedAt": stopped})
    out.sort(key=lambda x: x["stoppedAt"], reverse=True)
    return out


ACTIVE_RE = re.compile(r"^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d) (?:switched to (\S+)|auto-saved login of (\S+)|saved login of (\S+) \(auto\))$")


def active_timeline():
    """[(epoch, account)] from the switch log: from that time, Claude used that account.
    A switch and an auto save both show the active account. A save on switch does not:
    it saves the account that Claude leaves."""
    out = []
    for line in log_tail(n=None):
        m = ACTIVE_RE.match(line)
        if m:
            with contextlib.suppress(ValueError, OverflowError):
                t = time.mktime(time.strptime(m[1], "%Y-%m-%d %H:%M:%S"))
                out.append((t, m[2] or m[3] or m[4]))
    out.sort()
    return out


def owner_at(at, timeline, known, fallback):
    """The account that used Claude at `at` (epoch), from the switch log timeline. `fallback`
    (the folder of the newest copy of the session) when the log has no known account before `at`."""
    if at is None:
        return fallback
    active = [a for t, a in timeline if t <= at]
    return active[-1] if active and active[-1] in known else fallback


def limit_window(text):
    t = text.lower()
    if "weekly limit" in t:
        return "week"
    if "5-hour limit" in t or "session limit" in t:
        return "5h"
    return None


LIMIT_SCAN = os.path.join(BASE, "limit-scan.json")
ERROR_MARK = b'"isApiErrorMessage":true'


def limit_error(line):
    """(epoch, text) of a transcript line that is a usage-limit error, else None."""
    try:
        e = json.loads(line)
        hit = datetime.datetime.fromisoformat(e["timestamp"].replace("Z", "+00:00")).timestamp()
    except (ValueError, KeyError, TypeError, AttributeError):
        return None
    if not isinstance(e, dict) or not e.get("isApiErrorMessage"):
        return None
    content = (e.get("message") or {}).get("content")
    text = " ".join(c.get("text", "") for c in content if isinstance(c, dict)) if isinstance(content, list) else str(content)
    return (hit, text, e["timestamp"]) if "limit" in text.lower() else None


def scan_transcript(path, entry, cutoff):
    """Usage-limit errors in a transcript after `cutoff`, read from where the last scan stopped.
    Transcripts only grow, so `entry` ({size, head, hits: [[epoch, text, iso time]]}) keeps the
    bytes already read. One session can hit limits on several accounts, so all hits are kept.
    A transcript that got shorter, or whose first 4 KB changed, was rewritten: it is read again
    from the start. Only a hash of the first 4 KB is kept, not the text."""
    size = os.path.getsize(path)
    with open(path, "rb") as f:
        head = hashlib.sha1(f.read(4096)).hexdigest()
    if (not isinstance(entry, dict) or not isinstance(entry.get("size"), int) or entry["size"] > size
            or entry.get("head") != head and entry["size"] > 0):
        entry = {"size": 0}
    hits = [h for h in entry.get("hits") or [] if isinstance(h, list) and len(h) == 3  # a bad cache is dropped
            and isinstance(h[0], (int, float)) and isinstance(h[1], str) and isinstance(h[2], str) and h[0] >= cutoff]
    entry = dict(entry, head=head, hits=hits)
    if entry["size"] == size:
        return entry
    with open(path, "rb") as f:
        f.seek(entry["size"])
        pos, rest = entry["size"], b""
        while chunk := f.read(1 << 24):
            rest += chunk
            end = rest.rfind(b"\n") + 1  # only whole lines; a half-written line waits
            for line in rest[:end].split(b"\n"):
                if ERROR_MARK in line:
                    found = limit_error(line)
                    if found and found[0] >= cutoff:
                        hits.append(list(found))
            pos, rest = pos + end, rest[end:]
    entry["size"] = pos
    return entry


def limit_hits(days=8):
    """{account: newest usage-limit error in the last `days`}: {window, hitAt, resets, resetsAt}.
    A session can be in several account folders (sync copies it), so the error belongs to the
    account the switch log shows as active at the error time. Without a log entry before that
    time, it belongs to the newest copy, as in paused_sessions."""
    cutoff = time.time() - days * 86400
    cache = read_json(LIMIT_SCAN, {})
    cache = cache if isinstance(cache, dict) and cache.get("v") == 3 else {}
    old_sessions = cache.get("sessions") if isinstance(cache.get("sessions"), dict) else {}
    old_scans = cache.get("transcripts") if isinstance(cache.get("transcripts"), dict) else {}
    files = {}  # session file name -> (mtime, path) of the newest copy
    for f in glob.glob(os.path.join(SESS, "*", "*", "local_*.json")):
        m = os.path.getmtime(f)
        name = os.path.basename(f)
        if m >= cutoff and (name not in files or files[name][0] < m):
            files[name] = (m, f)
    sessions, newest = {}, {}  # newest: cli session -> (mtime, account of the newest copy)
    for name, (m, f) in files.items():
        known_cli = old_sessions.get(name)
        if isinstance(known_cli, list) and len(known_cli) == 2 and known_cli[0] == m:
            cli = known_cli[1]  # the file did not change: no need to parse it again
        else:
            cli = session_data(f).get("cliSessionId")
            cli = cli if isinstance(cli, str) and cli else None
        sessions[name] = [m, cli]
        if cli and (cli not in newest or newest[cli][0] < m):
            newest[cli] = (m, f.split(os.sep)[-3])
    scans = {}
    for cli in newest:
        entry = old_scans.get(cli) if isinstance(old_scans.get(cli), dict) else {}
        path = entry.get("path")
        if not (isinstance(path, str) and os.path.isfile(path)):
            paths = glob.glob(f"{HOME}/.claude/projects/*/{glob.escape(cli)}.jsonl")
            path, entry = (paths[0], {}) if paths else (None, {})
        if path:
            with contextlib.suppress(OSError):
                scans[cli] = dict(scan_transcript(path, entry, cutoff), path=path)
    new_cache = {"v": 3, "sessions": sessions, "transcripts": scans}
    if new_cache != cache:
        with contextlib.suppress(OSError):
            write_json(LIMIT_SCAN, new_cache)
    timeline = active_timeline()
    known = set(known_accounts())
    out = {}
    for cli, entry in scans.items():
        for hit, text, at in entry["hits"]:
            account = owner_at(hit, timeline, known, newest[cli][1])
            if account in out and out[account]["hitAt"] >= hit:
                continue
            reset = re.search(r"resets? ([^·\n]+)", text)
            resets = reset.group(1).strip() if reset else ""
            out[account] = {"window": limit_window(text), "hitAt": hit, "resets": resets,
                            "resetsAt": reset_timestamp(resets, at)}
    return out


def decrypt_cookies(db, password):
    """{name: value} of the claude.ai cookies in a COPY of a Chromium cookie database.
    Values are "v10": AES-128-CBC with a PBKDF2 key of the Claude Safe Storage password; database
    version 24 puts a 32-byte hash of the host in front. Raises ValueError when nothing decrypts."""
    key = hashlib.pbkdf2_hmac("sha1", password.encode(), b"saltysalt", 1003, 16)
    with tempfile.TemporaryDirectory() as tmp:
        copy = os.path.join(tmp, "Cookies")
        shutil.copy2(db, copy)
        con = sqlite3.connect(copy)
        try:
            version = int(dict(con.execute("select key, value from meta")).get("version", 0))
            rows = con.execute("select name, encrypted_value from cookies where host_key like '%claude.ai'").fetchall()
        finally:
            con.close()
    out = {}
    for name, blob in rows:
        if not isinstance(blob, bytes) or not blob.startswith(b"v10"):
            continue
        r = subprocess.run(["/usr/bin/openssl", "enc", "-d", "-aes-128-cbc", "-nosalt", "-K", key.hex(), "-iv", "20" * 16],
                           input=blob[3:], capture_output=True)
        if r.returncode == 0:
            with contextlib.suppress(UnicodeDecodeError):
                out[name] = (r.stdout[32:] if version >= 24 else r.stdout).decode("utf-8")
    if rows and not out:
        raise ValueError("no cookie decrypts")
    return out


def usage_cookies(password):
    """For each account with a login: {ok, org, cookie, error}. The active account uses Claude's own
    cookies, the others their saved login. The app sends the request itself (URLSession): Cloudflare
    challenges the system Python and curl (docs/usage-live.md). The password comes on stdin. The
    output goes only to the app through a pipe; the engine never writes the password or a cookie."""
    cur = current_account()
    out = {}
    for a in known_accounts():
        db = os.path.join(APP, "Cookies") if a == cur else os.path.join(PROFILES, a, "Cookies")
        if not os.path.isfile(db):
            continue
        try:
            cookies = decrypt_cookies(db, password)
        except (ValueError, OSError, sqlite3.Error):
            out[a] = {"ok": False, "org": None, "cookie": None, "error": "decrypt"}
            continue
        if "sessionKey" not in cookies or "lastActiveOrg" not in cookies:
            out[a] = {"ok": False, "org": None, "cookie": None, "error": "no-login"}
            continue
        out[a] = {"ok": True, "org": cookies["lastActiveOrg"], "error": None,
                  "cookie": "; ".join(f"{n}={cookies[n]}" for n in USAGE_COOKIES if n in cookies)}
    errors = collections.Counter(r["error"] for r in out.values() if not r["ok"])
    why = f" ({', '.join(f'{e}: {n}' for e, n in sorted(errors.items()))})" if errors else ""
    log(f"usage-cookies: {sum(r['ok'] for r in out.values())} ok, {sum(errors.values())} failed{why}")
    return {"accounts": out}


def list_backups():
    if not os.path.isdir(BACKUPS):
        return []
    out = []
    for d in sorted(os.listdir(BACKUPS), reverse=True):
        p = os.path.join(BACKUPS, d)
        info = backup_kind(d)
        if os.path.isdir(p) and info:
            n = sum(1 for _ in glob.glob(os.path.join(p, "*", "*", "local_*.json")))
            out.append({"name": d, **info, "sessions": n, "modified": os.path.getmtime(p)})
    return out


def backup_kind(name):
    """{"kind": daily | pre-restore | removed, "time": shown time, "account": 8 characters (removed)}
    from a backup folder name, or None when the folder is not a backup."""
    if re.fullmatch(r"\d{4}-\d\d-\d\d", name):
        return {"kind": "daily", "time": name}
    m = re.fullmatch(r"(pre-restore|removed)-(\d{4})(\d\d)(\d\d)-(\d\d)(\d\d)(\d\d)?(?:-(\w+))?", name)
    if not m or (m[1] == "removed") != bool(m[8]):
        return None
    out = {"kind": m[1], "time": f"{m[2]}-{m[3]}-{m[4]} {m[5]}:{m[6]}"}
    if m[8]:
        out["account"] = m[8]
    return out


def restore(name):
    require_no_pending()
    b = next((b for b in list_backups() if b["name"] == name), None)
    if not b:
        raise Fail(f"No backup named {name}.")
    if b["kind"] == "removed":
        return restore_removed(name)
    with lock():
        running = claude_running()
        quit_claude()
        undo = pre_restore_backup()
        subprocess.run(["rsync", "-a", "--delete", os.path.join(BACKUPS, name) + "/", SESS + "/"], check=True)
        if running:
            open_claude()
    log(f"restored backup {name} (undo: {undo})")
    return {"ok": True, "restored": name, "undo": undo}


def pre_restore_backup():
    """Copy the session lists to a "pre-restore-…" backup (the undo of a restore). Keeps the last 3."""
    undo = f"pre-restore-{datetime.datetime.now():%Y%m%d-%H%M%S}"
    os.makedirs(BACKUPS, exist_ok=True)
    if os.path.isdir(SESS):
        subprocess.run(["rsync", "-a", SESS + "/", os.path.join(BACKUPS, undo) + "/"], check=True)
    pre = sorted(d for d in os.listdir(BACKUPS) if d.startswith("pre-restore-"))
    for old in pre[:-3]:
        shutil.rmtree(os.path.join(BACKUPS, old), ignore_errors=True)
    return undo


def restore_removed(name):
    """Put the session folder of a removed account back. Other accounts are not touched.
    The account comes back as "not mine" and without a saved login. A file that is newer
    in Claude (the user signed in to the account again) is kept: only missing and older
    files are copied."""
    src = os.path.join(BACKUPS, name)
    with lock():
        undo = pre_restore_backup()
        for acc in os.listdir(src):
            if os.path.isdir(os.path.join(src, acc)):
                subprocess.run(["rsync", "-a", "--update", os.path.join(src, acc) + "/", os.path.join(SESS, acc) + "/"],
                               check=True)
    log(f"restored removed account from backup {name} (undo: {undo})")
    return {"ok": True, "restored": name, "undo": undo}


def backup(keep):
    os.makedirs(BACKUPS, exist_ok=True)
    dest = os.path.join(BACKUPS, f"{datetime.date.today():%Y-%m-%d}")
    subprocess.run(["rsync", "-a", SESS + "/", dest + "/"], check=True)
    days = sorted(d for d in os.listdir(BACKUPS) if re.fullmatch(r"\d{4}-\d\d-\d\d", d))
    for old in days[:-keep] if keep > 0 else []:
        shutil.rmtree(os.path.join(BACKUPS, old), ignore_errors=True)
    log(f"backup -> {dest}")
    return dest


