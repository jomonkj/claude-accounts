    times[target] = time.time()
    write_json(SWITCHED, times)


def status():
    s = settings()
    cur = current_account()
    labels = dict(s["labels"])
    cli = cli_accounts()
    for acc, email in cli_emails().items():
        labels.setdefault(acc, email)
    switched = switch_times()
    limits = limit_hits()
    dirs = account_dirs()
    accounts = []
    for a in known_accounts():
        files = [f for d in dirs.get(a, []) for f in glob.glob(os.path.join(d, "local_*.json"))]
        meta = profile_meta(a)
        accounts.append({
            "id": a, "name": labels.get(a, ""), "sessions": len(files),
            "lastUsed": max((os.path.getmtime(f) for f in files), default=0),
            "savedLogin": meta is not None, "savedAt": (meta or {}).get("savedAt", 0),
            "savedMode": (meta or {}).get("mode", ""),
            "current": a == cur, "hidden": a in s["hidden"], "owned": a in s["owned"],
            "switchedAt": switched.get(a, 0), "details": account_details(cli.get(a, {})),
            "limit": limits.get(a),
        })
    accounts.sort(key=lambda x: (not x["current"], -x["sessions"], -x["lastUsed"], x["id"]))
    v = claude_version()
    running = lock_held()
    return {"current": cur, "signedIn": has_login(), "claudeRunning": claude_running(),
            "claudeVersion": v, "versionTested": v in tested_versions(s),
            "layoutProblems": layout_problems(),
            # A journal while the lock is held is a switch in progress, not one to repair.
            "switchRunning": running, "pendingRecovery": pending() is not None and not running,
            "settings": {k: val for k, val in s.items() if k not in ("labels", "importedV1Labels", "verifiedVersions", "owned")},
            "accounts": accounts, "paused": paused_sessions()}


EMAIL_RE = r"[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+"
UUID_RE = r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
TOKEN_RE = re.compile(rf"{EMAIL_RE}|{UUID_RE}|(?<![0-9A-Za-z])[0-9a-fA-F]{{8}}(?![0-9A-Za-z])")


def redact(text, accounts, emails):
    """Replace each email and account ID (full or 8 characters) with "account N".
    The same account gets the same N everywhere in the text: an ID is known by its first
    8 characters, and a known email by its account. `emails` is {email: account}."""
    text = re.sub(r"/Users/[^/\s]+", "~", text.replace(HOME, "~"))
    known = {a[:8].lower() for a in accounts}
    by_email = {e.lower(): a[:8].lower() for e, a in emails.items()}
    names = {}

    def sub(m):
        t = m.group(0).lower()
        if "@" not in t and len(t) == 8 and t.isdigit() and t not in known:
            return m.group(0)  # an 8-digit number, not an ID
        k = by_email.get(t, t) if "@" in t else t[:8]
        return names.setdefault(k, f"account {len(names) + 1}")

    return TOKEN_RE.sub(sub, text)


def app_version():
    """Version of the Claude Accounts app that holds this engine (Contents/Resources/claude-switch)."""
    plist = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "Info.plist")
    try:
        with open(plist, "rb") as f:
            return plistlib.load(f).get("CFBundleShortVersionString", "") or "unknown"
    except (OSError, plistlib.InvalidFileException, ValueError):
        return "unknown (not run from the app)"


def log_tail(n=200):
    lines = []
    for path in (LOG + ".1", LOG):  # the rotated log first, so the lines stay in order
        with contextlib.suppress(OSError), open(path, errors="replace") as f:
            lines += f.read().splitlines()
    return lines if n is None else lines[-n:]


def report(app_settings=None, live_usage=None):
    """A debug report to attach to a GitHub issue, with no emails and no account IDs.
    `app_settings` ({key: value}) are settings only the app knows, such as the keyboard shortcuts."""
    st = status()
    s = st["settings"]
    yn = lambda b: "yes" if b else "no"
    out = ["Claude Accounts debug report",
           f"Created: {datetime.datetime.now():%F %T}",
           f"App version: {app_version()}",
           f"macOS: {platform.mac_ver()[0] or 'unknown'} ({platform.machine()})",
           f"Claude version: {st['claudeVersion'] or 'not found'} (tested: {yn(st['versionTested'])})",
           "Layout check: " + ("; ".join(st["layoutProblems"]) or "known"),
           f"Claude running: {yn(st['claudeRunning'])}, signed in: {yn(st['signedIn'])}",
           f"Switch running: {yn(st['switchRunning'])}, pending recovery: {yn(st['pendingRecovery'])}",
           "", "Settings:"]
    out += [f"  {k}: {json.dumps(v)}" for k, v in sorted(s.items())]
    owned = settings()["owned"]
    out += [f"  owned: {json.dumps(owned)}"]
    out += [f"  {k}: {v}" for k, v in sorted((app_settings or {}).items())] or ["  shortcut settings: see the app"]
    out += ["", "Accounts:"]
    for a in st["accounts"]:
        flags = [f for f, on in (("current", a["current"]), ("mine", a["owned"]), ("hidden", a["hidden"]),
                                 ("saved login", a["savedLogin"])) if on]
        # Plan and limit window only: display name and org name could identify the user.
        plan = (a.get("details") or {}).get("plan") or "unknown"
        window = {"5h": "5-hour", "week": "weekly"}.get((a.get("limit") or {}).get("window"), "unknown") if a.get("limit") else "none"
        live = (live_usage or {}).get(a["id"])
        out.append(f"  {a['id']}: {a['sessions']} sessions" + (", " + ", ".join(flags) if flags else "")
                   + f", plan {plan}, last limit {window}" + (f", live usage {live}" if live else ""))
    if not st["accounts"]:
        out.append("  none")
    out += ["", f"Paused sessions: {len(st['paused'])}", "", "Last log lines:"]
    out += ["  " + line for line in log_tail()]
    accounts = {a["id"] for a in st["accounts"]} | set(owned) | set(s["hidden"])
    return redact("\n".join(out) + "\n", accounts, account_emails(st))


def account_emails(st):
    """{email: account} from the claude CLI and from the account names in status
    (a name is often the email), so an email and its account ID get the same placeholder."""
    out = {e: a for a, e in cli_emails().items()}
    for a in st["accounts"]:
        for e in re.findall(EMAIL_RE, a.get("name") or ""):
            out.setdefault(e, a["id"])
    return out


