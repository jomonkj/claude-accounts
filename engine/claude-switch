INFO_PLIST = os.environ.get("CLAUDE_INFO_PLIST", "/Applications/Claude.app/Contents/Info.plist")
# Claude versions on which a full switch was checked by hand. Versions that pass `verify`
# are added to settings["verifiedVersions"] automatically.
TESTED_VERSIONS = ["4.23118.0"]
