def cli_accounts():
    """{account: oauthAccount} known to the claude CLI: ~/.claude.json and ~/.claude-*/.claude.json
    (one per CLAUDE_CONFIG_DIR, for example the claude-b launcher). The first file wins."""
    out = {}
    for path in [CLI_JSON] + sorted(glob.glob(f"{HOME}/.claude-*/.claude.json")):
        data = read_json(path, {})
        o = data.get("oauthAccount") if isinstance(data, dict) else None
        if isinstance(o, dict) and isinstance(o.get("accountUuid"), str):
            out.setdefault(o["accountUuid"], o)
    return out


def cli_emails():
    return {a: o["emailAddress"] for a, o in cli_accounts().items() if isinstance(o.get("emailAddress"), str) and o["emailAddress"]}


def plan_text(o):
    """Plan name from the CLI oauthAccount: organizationType, plus the Max multiplier
    from userRateLimitTier. None when the type is not known."""
    kind = o.get("organizationType")
    if not isinstance(kind, str) or not kind:
        return None
    tier = o.get("userRateLimitTier") if isinstance(o.get("userRateLimitTier"), str) else ""
    mult = next((m for m in ("20x", "5x") if tier.endswith("_max_" + m)), None)
    base = {"claude_max": "Max", "claude_pro": "Pro", "claude_team": "Team",
            "claude_enterprise": "Enterprise"}.get(kind) or kind.removeprefix("claude_").replace("_", " ").title()
    if base == "Max":
        return f"Max {mult}" if mult else "Max"
    return f"{base} ({mult})" if mult and base in ("Team", "Enterprise") else base


def account_details(o):
    """{email, displayName, plan, orgName} from the CLI oauthAccount; each field may be None."""
    text = lambda k: o.get(k) if isinstance(o.get(k), str) and o.get(k) else None
    return {"email": text("emailAddress"), "displayName": text("displayName"),
            "plan": plan_text(o), "orgName": text("organizationName")}


SWITCHED = os.path.join(BASE, "switched.json")


def switch_times():
    """{account: epoch seconds of the last switch to it}."""
    data = read_json(SWITCHED, {})
    return {a: t for a, t in data.items() if isinstance(t, (int, float))} if isinstance(data, dict) else {}


def remember_switch(target):
