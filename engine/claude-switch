def switch(target, force=False):
    target = resolve(target)
    require_no_pending()
    if not profile_meta(target):
        raise Fail("No saved login for this account. Click Add account and sign in with it one time.")
    version, warn = guard(force)
    with lock():
        log(f"switch to {target}")
        checkpoint("started", op="switch", target=target, source=current_account(), version=version)
        quit_or_cancel()
        save_current("switch")
        checkpoint("saved")
        load_login(os.path.join(PROFILES, target))
        checkpoint("loaded")
        shared = 0
        s = settings()
        if s["syncOnSwitch"] and target in s["owned"] and s["syncConfirmed"]:
            backup(s["backupKeep"])
            shared = sync_sessions()["changes"]
        checkpoint("synced")
        open_claude()
        end_journal()
        remember_switch(target)
    log(f"switched to {target}")
    out = {"ok": True, "account": target, "shared": shared}
    if warn:
        out["warning"] = warn
    return out


def verify(target, timeout=45):
    target = resolve(target)
    end = time.time() + timeout
    while time.time() < end:
        if claude_running() and current_account() == target and has_login():
            time.sleep(0 if TEST else 8)  # Claude drops a bad login a few seconds after start
            if current_account() == target and has_login():
                return remember_version()
        time.sleep(0.1 if TEST else 2)
    if current_account() == target and has_login():
        return remember_version()
    log(f"verify failed for {target}")
    if current_account() != target:
        return {"ok": False, "message": "Claude is not on this account. The switch did not finish."}
    return {"ok": False, "message": "Claude did not stay signed in. The saved login may have expired. Sign in again in Claude; the app saves the new login."}


def remember_version():
    """A switch worked on this Claude version, so mark the version as tested."""
    v = claude_version()
    s = settings()
    if v and v not in tested_versions(s):
        s["verifiedVersions"] = sorted(set(s.get("verifiedVersions") or []) | {v})
        save_settings(s)
        log(f"Claude {v} added to tested versions")
    return {"ok": True}


def add(force=False):
    require_no_pending()
    version, warn = guard(force)
    with lock():
        log("add account")
        checkpoint("started", op="add", target=None, source=current_account(), version=version)
        quit_or_cancel()
        save_current("switch")
        checkpoint("saved")
        load_login(None)
        checkpoint("loaded")
        open_claude()
        end_journal()
    return {"ok": True, **({"warning": warn} if warn else {})}


# Steps of a removal, in journal order. Before the session folder is in the backups,
# recover rolls back (nothing of the account changed); after, it finishes the removal.
REMOVE_STEPS = ("started", "backed-up", "moved", "login-deleted", "settings-cleaned")


def move_dir(src, dest):
    """Move a folder. Atomic on one volume; else copy to dest.tmp, rename, then delete src."""
    if not (TEST and os.environ.get("CLAUDE_SWITCH_TEST_COPY_MOVE")):  # test seam: force the copy
        try:
            os.rename(src, dest)
            return
        except OSError:
            pass
    tmp = dest + ".tmp"
    shutil.rmtree(tmp, ignore_errors=True)
    shutil.copytree(src, tmp, symlinks=True)
    crash_point("copied")
    os.rename(tmp, dest)
    crash_point("renamed")
    shutil.rmtree(src)


def drop_from_settings(acc):
    """Remove an account from every account setting: labels, owned, hidden, order, pinned."""
    s = settings()
    for k in LIST_KEYS:
        v = s.get(k)
        if isinstance(v, list):
            s[k] = [x for x in v if x != acc]
        elif isinstance(v, dict):
            v.pop(acc, None)
    save_settings(s)


def finish_remove(j):
    """Idempotent rest of a removal, once the session folder is in the backups."""
    acc, dest = j["target"], j["dest"]
    src = os.path.join(SESS, acc)
    if os.path.isdir(src):  # the copy is complete (dest exists), the old folder is not deleted yet
        shutil.rmtree(src)
    checkpoint("moved")
    shutil.rmtree(os.path.join(PROFILES, acc), ignore_errors=True)
    checkpoint("login-deleted")
    drop_from_settings(acc)
    checkpoint("settings-cleaned")


def remove(acc):
    acc = resolve(acc)
    with lock():  # check inside the lock: a running switch changes the current account
        require_no_pending()
        if acc == current_account():
            raise Fail("This is the current account of Claude. Switch to another account first, then remove it.")
        log(f"remove account {acc}")
        name = f"removed-{datetime.datetime.now():%Y%m%d-%H%M%S}-{acc[:8]}"
        dest = os.path.join(BACKUPS, name)
        j = {"target": acc, "dest": dest, "name": name}
        checkpoint("started", op="remove", **j)
        if os.path.isdir(SESS):
            backup(settings()["backupKeep"])
        checkpoint("backed-up")
        src = os.path.join(SESS, acc)
        if os.path.isdir(src):
            os.makedirs(dest, exist_ok=True)
            move_dir(src, os.path.join(dest, acc))
        finish_remove({**j, "dest": dest})
        end_journal()
    log(f"removed account {acc} (sessions in backup {name})")
    return {"ok": True, "account": acc, "backup": name}


def recover_remove(j):
    """A removal stopped in the middle: finish it if the session folder is safe in the
    backups, else undo the partial copy so the account is untouched."""
    acc, dest = j.get("target") or "", j.get("dest") or ""
    moved = os.path.isdir(os.path.join(dest, acc)) if acc and dest else False
    if acc and (moved or j.get("step") in REMOVE_STEPS[2:]):
        finish_remove(j)
        return "finished"
    if dest:
        shutil.rmtree(os.path.join(dest, acc) + ".tmp", ignore_errors=True)
        with contextlib.suppress(OSError):
            os.rmdir(dest)
    return "rolled back"


def save_signed_in(target):
    """Step 3 of "Sign in to save": save the login only if Claude is signed in to `target`."""
    target = resolve(target)
    cur = current_account()
    if not cur or not has_login():
        return {"ok": True, "saved": False, "waiting": True}
    if cur != target:
        log(f"sign in to save: expected {target}, Claude is on {cur}")
        return {"ok": True, "saved": False, "match": False, "expected": target, "current": cur,
                "message": f"Claude is signed in to another account ({cur[:8]}). Nothing was saved. "
                           "In Claude, sign out. Then sign in to the account you picked."}
    try:
        with lock():
            if pending():
                raise Busy("A switch is not finished.")
            saved = save_live_login(target, "signin")
    except Busy:  # the tick or a switch runs now: the app asks again in a moment
        return {"ok": True, "saved": False, "waiting": True, "busy": True}
    if not saved:  # Claude changed account or signed out since the check above
        return {"ok": True, "saved": False, "waiting": True}
    return {"ok": True, "saved": True, "match": True, "account": target}


def save_live_login(acc, mode):
    """Save the login Claude uses now (Claude may run) as the login of `acc`. Used by the tick
    (mode "auto") and by Sign in to save ("signin"). The caller holds the lock. Saves nothing
    during an unfinished switch or when Claude is not signed in to `acc`. True when saved."""
    if pending() or current_account() != acc or not has_login():
        return False
    save_login(os.path.join(PROFILES, acc), mode)
    log(f"saved login of {acc} ({mode})")
    return True


def recover():
    j = pending()
    if not j:
        return {"ok": True, "recovered": False}
    if lock_held():
        return {"ok": True, "recovered": False, "running": True}  # the switch is still going
    with lock():
        step = j.get("step")
        if j.get("op") == "remove":
            action = recover_remove(j)
        elif step in ("loaded", "synced"):
            action = "finished"            # the target login is complete
        elif step == "saved" and os.path.isdir(LAST_STATE):
            load_login(LAST_STATE)         # the target login may be half loaded
            action = "rolled back"
        else:
            action = "nothing to undo"     # no file was changed yet
        if j.get("op") != "remove":    # a removal does not quit Claude
            open_claude()
        end_journal()
    log(f"recover: {action} ({j.get('op')} to {j.get('target')}, stopped after {step})")
    return {"ok": True, "recovered": True, "action": action, "step": step,
            "op": j.get("op"), "target": j.get("target")}


def sync_cmd(dry):
    if not owned():
        raise Fail("No account is marked as mine. Mark your own accounts first.")
    if dry:
        return sync_sessions(dry=True)
    require_no_pending()
    with lock():
        backup(settings()["backupKeep"])
        running = claude_running()
        quit_claude()  # Claude may write the same files while it runs
        try:
            out = sync_sessions()
        finally:
            if running:
                open_claude()
    s = settings()
    if not s["syncConfirmed"]:
        s["syncConfirmed"] = True
        save_settings(s)
    return out


def tick():
    s = settings()
    done = []
    try:
        with lock():
            if pending():
                return {"done": []}  # never save a half-switched login
            cur = current_account()
            if s["autoSaveLogins"] and cur and claude_running():
                meta = profile_meta(cur)
                if (not meta or time.time() - meta.get("savedAt", 0) > 6 * 3600) and save_live_login(cur, "auto"):
                    done.append("login")
            today = os.path.join(BACKUPS, f"{datetime.date.today():%Y-%m-%d}")
            if s["dailyBackup"] and not os.path.isdir(today) and os.path.isdir(SESS):
                backup(s["backupKeep"])
                done.append("backup")
    except Busy:
        pass  # a switch is running; try next time
    return {"done": done}


def version_tuple(v):
    nums = re.findall(r"\d+", (v or "").split("-")[0])
    return tuple(int(n) for n in nums[:3]) + (0,) * (3 - len(nums[:3]))


def _curl(url, out=None, timeout=30):
    """Fetch a URL with the system curl (no sign-in). Returns the body, or None with `out`. Raises Fail."""
    cmd = [CURL, "-fsSL", "--proto", CURL_PROTO, "--proto-redir", "=https", "--max-time", str(timeout),
           "-H", "Accept: application/vnd.github+json", url] + (["-o", out] if out else [])
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout + 10)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Fail(f"curl: {e}")
    if r.returncode != 0:
        raise Fail(r.stderr.strip() or f"curl: exit {r.returncode}")
    return None if out else r.stdout


def _release(tag=None):
    """A release from the public GitHub API: latest, or the one with `tag`. Raises Fail."""
    body = _curl(f"{API}/repos/{REPO}/releases/" + (f"tags/{tag}" if tag else "latest"))
    try:
        rel = json.loads(body)
    except ValueError:
        raise Fail("The release API did not return JSON")
    if not isinstance(rel, dict) or not rel.get("tag_name"):
        raise Fail("The release API returned no tag")
    return rel


def _latest_web():
    """(tag, page URL) of the latest release, from the redirect of github.com/<repo>/releases/latest."""
    try:
        r = subprocess.run([CURL, "-fsSLI", "--proto", "=https", "--max-time", "30", "-o", "/dev/null",
                            "-w", "%{url_effective}", f"{WEB}/{REPO}/releases/latest"],
                           capture_output=True, text=True, timeout=40)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Fail(f"curl: {e}")
    tag = r.stdout.rsplit("/tag/", 1)[-1] if "/tag/" in r.stdout else ""
    if r.returncode != 0 or not re.fullmatch(r"v\d+\.\d+\.\d+(-[\w.]+)?", tag):
        raise Fail(r.stderr.strip() or "github.com gave no release tag")
    return tag, r.stdout


def _gh_error(r):
    msg = (r.stderr or r.stdout).strip().splitlines()
    return msg[-1] if msg else "gh failed"


def update_check(current):
    """Latest release vs. the running version. Never fails: problems come back as `error`.

    Uses the public GitHub API with curl. gh is only a fallback, for when curl fails."""
    try:
        try:
            rel = _release()
            latest, url = rel["tag_name"], rel.get("html_url", "")
        except Fail as api_error:
            try:
                latest, url = _latest_web()
            except Fail:
                raise api_error
    except Fail as e:
        try:
            r = subprocess.run([GH, "release", "view", "--repo", REPO, "--json", "tagName,url,publishedAt"],
                               capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired):
            return {"available": False, "error": str(e)}
        if r.returncode != 0:
            return {"available": False, "error": f"{e}; gh: {_gh_error(r)}"}
        rel = json.loads(r.stdout)
        latest, url = rel.get("tagName", ""), rel.get("url", "")
    newer = version_tuple(latest) > version_tuple(current)
    return {"available": newer, "latest": latest, "current": current, "url": url}


def update_install(tag):
    """Download and install a release with the release's own install script, then reopen."""
    if not re.fullmatch(r"v\d+\.\d+\.\d+(-[\w.]+)?", tag or ""):
        raise Fail(f"Not a release tag: {tag}")
    work = os.path.join(BASE, "update")
    shutil.rmtree(work, ignore_errors=True)
    os.makedirs(work)
    script = os.path.join(work, "install-release.sh")
    try:
        try:
            assets = {a.get("name"): a.get("browser_download_url") for a in _release(tag).get("assets", [])}
        except Fail as api_error:  # API down or rate-limited: the github.com link of the asset
            try:
                _curl(f"{WEB}/{REPO}/releases/download/{tag}/install-release.sh", out=script, timeout=120)
            except Fail:
                raise api_error
        else:
            if not assets.get("install-release.sh"):
                raise Fail(f"Release {tag} has no install-release.sh")
            _curl(assets["install-release.sh"], out=script, timeout=120)
    except Fail as e:
        try:
            r = subprocess.run([GH, "release", "download", tag, "--repo", REPO, "--pattern", "install-release.sh",
                                "--dir", work], capture_output=True, text=True, timeout=120)
        except (OSError, subprocess.TimeoutExpired):
            raise Fail(f"Cannot download the release: {e}")
        if r.returncode != 0:
            raise Fail(f"Cannot download the release: {e}; gh: {_gh_error(r)}")
    log(f"update to {tag}")
    if TEST:
        return {"ok": True, "tag": tag, "script": script}
    # Run detached: the installer stops this app, replaces it, and opens the new version.
    path = "/usr/bin:/bin:/usr/sbin:/sbin"
    if os.path.isabs(GH):
        path = f"{os.path.dirname(GH)}:{path}"  # for the installer's gh fallback
    subprocess.Popen(["/bin/bash", script, "--tag", tag], stdout=open(os.path.join(work, "install.log"), "w"),
                     stderr=subprocess.STDOUT, start_new_session=True, env={**os.environ, "PATH": path})
    return {"ok": True, "tag": tag}


AGENT_LABEL = "local.claude-accounts"


def uninstall():
    """Remove the app, the login item and the CLI links. Keep the data folder and the backups.

    The app copies: ~/Applications (install-release.sh), /Applications (a drag-install) and the
    bundle this engine runs from. In test mode the steps that act outside $HOME (launchctl, pkill,
    the Finder Trash) are not run: they are listed in `stubbed`, and the app goes to $HOME/.Trash.
    If an app copy cannot be removed, the result is an error that names it and lists what was removed.
    """
    import pwd
    if TEST and os.path.realpath(HOME) == os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir):
        raise Fail("Test mode needs a temporary HOME. Nothing was changed.")
    apps = app_copies()
    agent = os.path.join(HOME, "Library", "LaunchAgents", AGENT_LABEL + ".plist")
    stop = [["/bin/launchctl", "bootout", f"gui/{os.getuid()}/{AGENT_LABEL}"], ["/usr/bin/pkill", "-x", "ClaudeAccounts"]]
    with lock():
        require_no_pending()
        removed = []
        for name in ("claude-switch", "claude-accounts"):
            link = os.path.join(HOME, ".local", "bin", name)
            # Only our own links: never delete a file the user put there.
            if os.path.islink(link) and "Claude Accounts.app" in os.readlink(link):
                os.remove(link); removed.append(link)
        if os.path.exists(agent):
            os.remove(agent); removed.append(agent)
        remaining = []
        for app in apps:
            try:
                trash_item(app); removed.append(app)
            except Fail as e:
                remaining.append(app); log(f"uninstall: {e}")
        log("uninstalled: " + ", ".join(removed))
    if remaining:  # the app is still there: do not stop it, and do not say it is gone
        raise Fail("Not finished. These app copies are still there: " + ", ".join(remaining)
                   + ". Move them to the Trash yourself. Removed: " + (", ".join(removed) or "nothing") + ".")
    out = {"ok": True, "removed": removed, "data": BASE, "backups": BACKUPS}
    if TEST:
        out["stubbed"] = [" ".join([os.path.basename(c[0])] + c[1:]) for c in stop]
        return out
    # Stop the login item and the app last: the app may be our parent, so print the result first.
    print(json.dumps(out), flush=True)
    with contextlib.suppress(OSError):
        os.setsid()
    for c in stop:
        subprocess.run(c, capture_output=True)
    return None


APP_NAME = "Claude Accounts.app"


def own_bundle():
    """The app bundle this engine runs from (Contents/Resources/claude-switch), or None."""
    res = os.path.dirname(os.path.realpath(__file__))
    bundle = os.path.dirname(os.path.dirname(res))
    if os.path.basename(res) != "Resources" or not bundle.endswith(".app"):
        return None
    with contextlib.suppress(OSError, plistlib.InvalidFileException, ValueError):
        with open(os.path.join(bundle, "Contents", "Info.plist"), "rb") as f:
            if plistlib.load(f).get("CFBundleIdentifier") == AGENT_LABEL:  # our bundle ID
                return bundle
    return None


def app_copies():
    """Every copy of the app to remove, without duplicates."""
    system = os.environ.get("CLAUDE_SWITCH_APPLICATIONS", "/Applications") if TEST else "/Applications"
    out = []
    for p in (os.path.join(HOME, "Applications", APP_NAME), os.path.join(system, APP_NAME), own_bundle()):
        if p and os.path.isdir(p) and os.path.realpath(p) not in {os.path.realpath(o) for o in out}:
            out.append(p)
    return out


def trash_item(path):
    if TEST:
        trash = os.path.join(HOME, ".Trash")
        os.makedirs(trash, exist_ok=True)
        dest, n = os.path.join(trash, os.path.basename(path)), 1
        while os.path.exists(dest):
            n += 1
            dest = os.path.join(trash, f"{os.path.basename(path)[:-4]} {n}.app")
        try:
            os.rename(path, dest)
        except OSError as e:
            raise Fail(f"Cannot move {path} to the Trash: {e.strerror}")
        return
    # NSFileManager puts it in the Trash with "Put Back", and needs no Finder automation permission.
    js = ("ObjC.import('Foundation');var e=$();"
          "if(!$.NSFileManager.defaultManager.trashItemAtURLResultingItemURLError("
          "$.NSURL.fileURLWithPath(" + json.dumps(path) + "),null,e))throw new Error('trash failed')")
    r = subprocess.run(["/usr/bin/osascript", "-l", "JavaScript", "-e", js], capture_output=True, text=True)
    if r.returncode != 0:
        raise Fail(f"Cannot move the app to the Trash: {r.stderr.strip()}")


def main(argv):
    cmd, args = (argv[1] if len(argv) > 1 else "status"), argv[2:]
    if os.path.basename(argv[0]) == "claude-accounts" and len(argv) == 1:
        cmd = "list"
    s = settings()
    if cmd == "status":
        out = status()
    elif cmd == "list":
        return cmd_list()
    elif cmd == "switch":
        rest = [a for a in args if a != "--force"]
        out = switch(rest[0] if rest else "", force="--force" in args)
    elif cmd == "verify":
        out = verify(args[0] if args else "")
    elif cmd == "add":
        out = add(force="--force" in args)
    elif cmd == "save-login":
        out = save_signed_in(args[0] if args else "")
    elif cmd == "recover":
        out = recover()
    elif cmd in ("sync", "share"):
        out = sync_cmd("--dry-run" in args)
    elif cmd in ("mine", "not-mine"):
        acc = resolve(args[0] if args else "")
        o = set(s["owned"]); (o.add if cmd == "mine" else o.discard)(acc)
        s["owned"] = sorted(o); save_settings(s); out = {"ok": True}
    elif cmd == "backups":
        out = {"backups": list_backups()}
    elif cmd == "restore":
        out = restore(args[0] if args else "")
    elif cmd == "tick":
        out = tick()
    elif cmd == "backup":
        out = {"path": backup(s["backupKeep"])}
    elif cmd == "label":
        acc, name = (resolve(args[0]), args[1]) if len(args) > 1 else (current_account(), args[0] if args else "")
        if name.strip():
            s["labels"][acc] = name.strip()
        else:
            s["labels"].pop(acc, None)
        save_settings(s); out = {"ok": True}
    elif cmd == "forget":
        acc = resolve(args[0] if args else "")
        shutil.rmtree(os.path.join(PROFILES, acc), ignore_errors=True)
        log(f"forgot login of {acc}"); out = {"ok": True}
    elif cmd == "remove":
        out = remove(args[0] if args else "")
    elif cmd in ("hide", "unhide"):
        acc = resolve(args[0] if args else "")
        h = set(s["hidden"]); (h.add if cmd == "hide" else h.discard)(acc)
        s["hidden"] = sorted(h); save_settings(s); out = {"ok": True}
    elif cmd == "order":
        order = [resolve(a) for a in args]
        if len(set(order)) != len(order):
            raise Fail("Each account can be in the order only once.")
        s["order"] = order; save_settings(s); out = {"ok": True}
    elif cmd in ("pin", "unpin"):
        acc = resolve(args[0] if args else "")
        p = [a for a in s["pinned"] if a != acc]
        s["pinned"] = p + [acc] if cmd == "pin" else p
        save_settings(s); out = {"ok": True}
    elif cmd == "set":
        if len(args) != 2 or args[0] not in DEFAULTS or args[0] in LIST_KEYS:
            raise Fail("Usage: set <" + "|".join(k for k in DEFAULTS if k not in LIST_KEYS) + "> <value>")
        v = args[1].lower()
        s[args[0]] = v in ("1", "true", "on", "yes") if isinstance(DEFAULTS[args[0]], bool) else int(v)
        save_settings(s); out = {"ok": True}
    elif cmd == "report":
        app, live = {}, {}
        for i, a in enumerate(args):
            value = args[i + 1] if i + 1 < len(args) else ""
            if a == "--app-setting":
                m = re.fullmatch(r"(\w+)=(\w+)", value)
                if not m:
                    raise Fail("Usage: report [--app-setting <key>=<value>]... [--live-usage <account>=<state>]...")
                app[m[1]] = m[2]
            elif a == "--live-usage":  # from the app: ok or an error type, never a number or a cookie
                m = re.fullmatch(r"([0-9A-Za-z-]+)=(ok|[a-z]+(?:-\d{3})?)", value)
                if not m:
                    raise Fail("Usage: report [--app-setting <key>=<value>]... [--live-usage <account>=<state>]...")
                live[m[1]] = m[2]
        sys.stdout.write(report(app, live)); return 0
    elif cmd == "update-check":
        out = update_check(args[0] if args else "0.0.0")
    elif cmd == "update-install":
        out = update_install(args[0] if args else "")
    elif cmd == "uninstall":
        out = uninstall()
        if out is None:  # already printed
            return 0
    elif cmd == "usage-cookies":
        if args:
            raise Fail("usage-cookies takes no arguments. Give the Claude Safe Storage password on stdin only.")
        password = "" if sys.stdin.isatty() else sys.stdin.readline().strip()
        if not password:
            raise Fail("Give the Claude Safe Storage password on stdin.")
        out = usage_cookies(password)
    elif cmd == "open-session":
        open_claude(f"claude://claude.ai/epitaxy/{args[0]}"); out = {"ok": True}
    else:
        print(__doc__); return 1
    print(json.dumps(out))
    return 0


